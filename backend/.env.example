# ==============================================================
# Udhaar V1 Production Environment Configuration
# ==============================================================

# Server
PORT=5000
NODE_ENV=production
JWT_SECRET=generate_a_strong_64_character_hex_secret_here

# Public Frontend URL (Used for generating QR Codes and links)
# e.g. https://udhaar.robotpdf.com or in future https://udhaar.app
PUBLIC_WEB_URL=https://udhaar.robotpdf.com

# Database Mode: "supabase" (live PostgreSQL) or "local" (SQLite udhaar.db)
DB_MODE=supabase

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# SMS & OTP Gateway (Options: "fast2sms", "twilio", or "dev")
SMS_PROVIDER=dev

# Fast2SMS Configuration (https://www.fast2sms.com)
FAST2SMS_API_KEY=

# Twilio Configuration (https://www.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
